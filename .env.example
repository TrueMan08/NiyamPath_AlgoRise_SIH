# ==============================================================================
# NiyamPath — Global Environment Configuration Template (.env.example)
# Team AlgoRise | SIH 2026 | Problem Statement 26262
# NOTE: Copy this file to .env and configure values. Do NOT commit real secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (React / Vite)
# ------------------------------------------------------------------------------
VITE_APP_NAME="NiyamPath"
VITE_APP_TAGLINE="Every Process. Every Requirement. On Track."
VITE_API_BASE_URL="http://localhost:8080/api"
VITE_AI_SERVICE_URL="http://localhost:8000"
VITE_ENABLE_MOCK_FALLBACK="true"

# ------------------------------------------------------------------------------
# CORE BACKEND CONFIGURATION (Spring Boot)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/niyampath_db
SPRING_DATASOURCE_USERNAME=niyampath_user
SPRING_DATASOURCE_PASSWORD=placeholder_secure_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# Security & JWT Configuration
JWT_SECRET=placeholder_super_secret_jwt_key_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000

# AI Service Gateway Integration
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# AI SERVICE CONFIGURATION (FastAPI)
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development

# LLM Provider Configuration (Gemini API / OpenAI compatible)
LLM_PROVIDER=gemini
GEMINI_API_KEY=placeholder_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Embeddings & RAG Configuration
EMBEDDING_MODEL=models/text-embedding-004
RAG_KNOWLEDGE_DIR=./data/regulatory_docs
CHROMA_PERSIST_DIR=./data/chroma_db

# OCR & Document Processing
ENABLE_LOCAL_OCR=true
TESSERACT_CMD=/usr/bin/tesseract

